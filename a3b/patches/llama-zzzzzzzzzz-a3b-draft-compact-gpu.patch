+namespace {
+// Only the A3B MTP's known GPU greedy sampler can consume compact logits.
+// Other callers retain the full-vocabulary scatter, including CPU sampling.
+bool strata_a3b_compact_draft_gpu(const llama_model & model, const llama_cparams & cparams,
+                                  const llama_ubatch & ubatch,
+                                  const std::map<llama_seq_id, llama_sampler *> & samplers) {
+    const char * enabled = std::getenv("STRATA_A3B_DRAFT_COMPACT_GPU");
+    if (!enabled || enabled[0] != '1' || enabled[1] != '\0' || !model.d2t ||
+        model.d2t->type != GGML_TYPE_I32 || cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+        ggml_backend_dev_type(model.dev_output()) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+        samplers.size() != 1 || samplers.begin()->first != 0) return false;
+    auto * sampler = samplers.begin()->second;
+    auto * child = sampler && llama_sampler_chain_n(sampler) == 1 ?
+        llama_sampler_chain_get(sampler, 0) : nullptr;
+    if (!child || std::strcmp(llama_sampler_name(child), "strata-device-greedy-guard") != 0)
+        return false;
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (ubatch.output[i] && (!ubatch.seq_id || !ubatch.n_seq_id ||
+                                 ubatch.n_seq_id[i] != 1 || ubatch.seq_id[i][0] != 0))
+            return false;
+    }
+    return true;
+}
+}
 
