+// The A3B MTP prefill bridge only accepts same-device CUDA tensors. GGML's
+// async tensor copy then records an event on the target stream and makes the
+// draft stream wait for it; it never stages the hidden rows through host RAM.
+static bool mtp_device_cuda_backend(ggml_backend_t backend) {
+    const char * name = backend ? ggml_backend_name(backend) : nullptr;
+    return name && std::strncmp(name, "CUDA", 4) == 0;
+}
+
+static bool mtp_device_hidden_layout(const ggml_tensor * t, uint32_t width, uint32_t rows) {
+    if (!t || !t->data || t->type != GGML_TYPE_F32 || t->ne[0] != width || t->ne[1] < rows ||
+        t->ne[2] != 1 || t->ne[3] != 1 || t->nb[0] != sizeof(float) ||
+        t->nb[1] != size_t(width) * sizeof(float)) return false;
+    const ggml_backend_buffer_t buffer = t->view_src ? t->view_src->buffer : t->buffer;
+    return buffer && !ggml_backend_buffer_is_host(buffer);
+}
+
+static bool mtp_host_hidden_layout(const ggml_tensor * t, uint32_t width, uint32_t rows) {
+    return t && t->data && t->type == GGML_TYPE_F32 && t->ne[0] == width && t->ne[1] >= rows &&
+           t->ne[2] == 1 && t->ne[3] == 1 && t->nb[0] == sizeof(float) &&
+           t->nb[1] == size_t(width) * sizeof(float);
+}
+
+static bool mtp_device_cuda_buffer(const ggml_tensor * t, ggml_backend_t backend) {
+    const auto buffer = t->view_src ? t->view_src->buffer : t->buffer;
+    return buffer && mtp_device_cuda_backend(backend) &&
+           ggml_backend_buffer_get_type(buffer) == ggml_backend_get_default_buffer_type(backend);
+}
+
+static ggml_tensor mtp_device_hidden_slice(const ggml_tensor * base, uint32_t row, uint32_t rows) {
+    ggml_tensor slice = *base;
+    slice.data = static_cast<char *>(base->data) + size_t(row) * base->nb[1];
+    slice.ne[1] = rows;
+    slice.ne[2] = slice.ne[3] = 1;
+    slice.nb[2] = slice.nb[3] = size_t(rows) * slice.nb[1];
+    return slice;
+}
+
+static ggml_tensor mtp_device_pending_tensor(const ggml_tensor * shape, ggml_backend_buffer_t buffer) {
+    ggml_tensor row = mtp_device_hidden_slice(shape, 0, 1);
+    row.data = ggml_backend_buffer_get_base(buffer);
+    row.buffer = buffer;
+    row.view_src = nullptr;
+    row.view_offs = 0;
+    return row;
 }
 
