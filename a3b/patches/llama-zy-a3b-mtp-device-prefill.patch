+int llama_mtp_device_prefill_decode(llama_context * target, llama_context * draft,
+                                   llama_batch batch, uint32_t width) {
+    if (!target || !draft || target == draft || !batch.token || !batch.embd ||
+        batch.n_tokens < 1 || width == 0 || draft->get_cparams().ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+        !target->get_cparams().embeddings_nextn || target->get_cparams().embeddings_nextn_masked ||
+        draft->mtp_device_prefill.target) return 0;
+    const auto * result = target->gf_res_prev_active;
+    auto * source = result ? result->get_h_nextn() : nullptr;
+    if (!mtp_device_hidden_layout(source, width, (uint32_t) batch.n_tokens)) return 0;
+    const auto source_backend = ggml_backend_sched_get_tensor_backend(target->sched.get(), source);
+    if (!mtp_device_cuda_buffer(source, source_backend)) return 0;
+    const auto source_device = ggml_backend_get_device(source_backend);
+    bool draft_same_device = false;
+    for (const auto & backend : draft->backends)
+        if (mtp_device_cuda_backend(backend.get()) && ggml_backend_get_device(backend.get()) == source_device)
+            draft_same_device = true;
+    if (!draft_same_device) return 0;
+
+    auto & bridge = draft->mtp_device_prefill;
+    if (bridge.pending && (bridge.width != width || bridge.source_device != source_device)) return 0;
+    if (!bridge.pending) {
+        bridge.pending.reset(ggml_backend_buft_alloc_buffer(
+            ggml_backend_get_default_buffer_type(source_backend), size_t(width) * sizeof(float)));
+        if (!bridge.pending) return 0;
+        bridge.width = width;
+        bridge.source_device = source_device;
+    }
+    if (!bridge.pending_valid) {
+        ggml_backend_buffer_clear(bridge.pending.get(), 0);
+        bridge.pending_valid = true;
+    }
+    bridge.target = target;
+    bridge.source = source;
+    bridge.source_backend = source_backend;
+    bridge.total_rows = (uint32_t) batch.n_tokens;
+    bridge.copied_rows = 0;
+    bridge.host_fallback = false;
+    int rc = -1;
+    try {
+        rc = draft->decode(batch);
+    } catch (...) {
+        bridge.target = nullptr;
+        bridge.source = nullptr;
+        bridge.source_backend = nullptr;
+        throw;
+    }
+    bridge.target = nullptr;
+    bridge.source = nullptr;
+    bridge.source_backend = nullptr;
+    if (rc != 0 || bridge.copied_rows != (uint32_t) batch.n_tokens) return -1;
+
+    // Save the final target row for the next prompt block. Both copies and
+    // the next target compute use the target stream, so that compute cannot
+    // overwrite source storage before this transfer has completed.
+    auto source_last = mtp_device_hidden_slice(source, (uint32_t) batch.n_tokens - 1, 1);
+    auto pending = mtp_device_pending_tensor(source, bridge.pending.get());
+    ggml_backend_tensor_copy_async(source_backend, source_backend, &source_last, &pending);
+    bridge.pending_backend = source_backend;
+    auto & host = target->mtp_prefill_host;
+    if (host.deferred) {
+        if (host.source != source || host.backend != source_backend ||
+            host.rows != (uint32_t) batch.n_tokens || host.width != width || !target->embd_nextn.data)
+            return -1;
+        // Preserve the only row needed by the first proposal. The target's
+        // ordinary getter synchronizes its stream before exposing this row.
+        ggml_backend_tensor_get_async(source_backend, &source_last,
+            target->embd_nextn.data + size_t(batch.n_tokens - 1) * width,
+            0, size_t(width) * sizeof(float));
+        host.deferred = false;
+        host.last_only = true;
+        host.saved_bytes = size_t(batch.n_tokens - 1) * width * sizeof(float);
+    }
+    if (bridge.host_fallback) return 2; // draft KV advanced using restored host hidden rows
+    ++bridge.calls;
+    bridge.rows += (uint32_t) batch.n_tokens;
+    return 1;
+}
+
+void llama_mtp_device_prefill_reset(llama_context * draft) {
+    if (!draft) return;
+    auto & bridge = draft->mtp_device_prefill;
+    if (bridge.target) throw std::runtime_error("cannot reset an active MTP device prefill bridge");
+    // The previous request may have ended before anyone synchronized the
+    // target stream (for example, a prompt-only request). Finish its last-row
+    // copy before a new request zeros the shared pending buffer.
+    if (bridge.pending_backend) ggml_backend_synchronize(bridge.pending_backend);
+    bridge.pending_backend = nullptr;
+    bridge.pending_valid = false;
+    bridge.host_fallback = false;
+    bridge.copied_rows = bridge.total_rows = 0;
+    bridge.calls = bridge.rows = 0;
+}
+
+void llama_mtp_device_prefill_host_arm(llama_context * target, uint32_t rows, uint32_t width) {
+    if (!target) return;
+    auto & host = target->mtp_prefill_host;
+    host = {};
+    host.armed = rows > 0 && width > 0 && target->get_cparams().embeddings_nextn &&
+        !target->get_cparams().embeddings_nextn_masked;
+    host.rows = rows;
+    host.width = width;
+}
+
+void llama_mtp_device_prefill_host_disarm(llama_context * target) {
+    if (target) target->mtp_prefill_host.armed = false;
+}
+
+int llama_mtp_device_prefill_host_restore(llama_context * target) {
+    if (!target) return -1;
+    auto & host = target->mtp_prefill_host;
+    if (!host.deferred && !host.last_only) return 0;
+    const auto * result = target->gf_res_prev_active;
+    if (!host.source || !host.backend || !result || result->get_h_nextn() != host.source ||
+        !target->embd_nextn.data ||
+        !mtp_device_hidden_layout(host.source, host.width, host.rows)) return -1;
+    ggml_backend_tensor_get_async(host.backend, host.source, target->embd_nextn.data,
+        0, size_t(host.rows) * host.width * sizeof(float));
+    target->synchronize();
+    host.deferred = false;
+    host.last_only = false;
+    host.saved_bytes = 0;
+    return 0;
+}
+
+uint64_t llama_mtp_device_prefill_host_saved_bytes(const llama_context * target) {
+    return target ? target->mtp_prefill_host.saved_bytes : 0;
+}
