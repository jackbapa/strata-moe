+    if (!shapes || ggml_get_op_params_i32(gdn, 0) < 1 ||
+        state_view->src[0] != gdn || state_view->view_src != gdn ||
+        state_view->view_offs != score_bytes ||
+        state_cpy->src[0] != state_view || state_cpy->src[1] != state_cache ||
+        output_view->src[0] != gdn || output_view->view_src != gdn || output_view->view_offs != 0 ||
+        norm->src[0] != output_view || weighted->src[0] != norm ||
+        silu->src[0] != z || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU ||
+        y->src[0] != weighted || y->src[1] != silu) return 0;
+    const float eps = ggml_get_op_params_f32(norm, 0);
+    if (!(eps >= 0.0f) || !std::isfinite(eps)) return 0;
+    const ggml_tensor * checked[] = {q, k, v, gate, beta, state, gamma, z, y};
+    for (const ggml_tensor * t : checked) {
+        if (t->type != GGML_TYPE_F32 || t->data == nullptr || !ggml_is_contiguous(t)) return 0;
+    }
+    if (cache.data == nullptr ||
+        (cache.data != state->data && ggml_cuda_a3b_ranges_overlap(cache.data, state_bytes, state->data, state_bytes)))
+        return 0;
+    const ggml_tensor * inputs[] = {q, k, v, gate, beta, state, gamma, z};
+    for (const ggml_tensor * src : inputs) {
+        if (ggml_cuda_a3b_ranges_overlap(y->data, score_bytes, src->data,
+                ggml_nbytes(src))) return 0;
+    }
+    strata::kernels::fused_gdn_a3b_step_norm(
+        (const float *) state->data, cache.data, (const float *) q->data, (const float *) k->data,
+        (const float *) v->data, (const float *) gate->data, (const float *) beta->data,
+        (const float *) z->data, (const float *) gamma->data, eps, (float *) y->data,
+        16, 32, (void *) cuda_ctx->stream());
