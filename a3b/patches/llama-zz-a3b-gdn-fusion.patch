+    const char * trace = std::getenv("STRATA_A3B_GDN_GRAPH_TRACE");
+    if (trace && trace[0] == '1' && total <= 2) {
+        std::fprintf(stderr, "A3B Strata fused GDN graph match: %llu (single-token, 32 heads)\n",
+                     (unsigned long long) total);
+    }
+    return 9;
+}
