+    ggml_tensor * gdn = cgraph->nodes[i];
+    ggml_tensor * state_view = cgraph->nodes[i + 1];
+    ggml_tensor * state_cache = cgraph->nodes[i + 2];
+    ggml_tensor * state_cpy = cgraph->nodes[i + 3];
+    ggml_tensor * output_view = cgraph->nodes[i + 4];
+    ggml_tensor * norm = cgraph->nodes[i + 5];
+    ggml_tensor * weighted = cgraph->nodes[i + 6];
+    ggml_tensor * z = cgraph->nodes[i + 7];
+    ggml_tensor * silu = cgraph->nodes[i + 8];
+    ggml_tensor * y = cgraph->nodes[i + 9];
+    const ggml_tensor * q = gdn->src[0], * k = gdn->src[1], * v = gdn->src[2];
+    const ggml_tensor * gate = gdn->src[3], * beta = gdn->src[4], * state = gdn->src[5];
+    const ggml_tensor * gamma = weighted->src[1];
+    constexpr size_t score_bytes = 128 * 32 * sizeof(float);
+    constexpr size_t state_bytes = 128 * 128 * 32 * sizeof(float);
+    const bool shapes = v->ne[0] == 128 && v->ne[1] == 32 && v->ne[2] == 1 && v->ne[3] == 1 &&
+        q->ne[0] == 128 && q->ne[1] == 16 && q->ne[2] == 1 && q->ne[3] == 1 &&
+        k->ne[0] == 128 && k->ne[1] == 16 && k->ne[2] == 1 && k->ne[3] == 1 &&
+        gate->ne[0] == 1 && gate->ne[1] == 32 && beta->ne[0] == 1 && beta->ne[1] == 32 &&
+        state->ne[0] == 128 && state->ne[1] == 128 && state->ne[2] == 32 && state->ne[3] == 1 &&
+        gamma->ne[0] == 128 && ggml_nelements(gamma) == 128 &&
+        z->ne[0] == 128 && z->ne[1] == 32 && ggml_nelements(z) == 4096 &&
+        ggml_nelements(y) == 4096 &&
