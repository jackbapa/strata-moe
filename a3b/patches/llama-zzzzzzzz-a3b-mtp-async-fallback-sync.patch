@@ -1451,5 +1451,14 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
     bool async_graph_retry = false;
