+// Optional same-device stream bridge for StrataMoE's RAM expert backend. A
+// disabled or absent provider returns nullptr, preserving the upstream path.
+static ggml_backend_t ggml_backend_sched_strata_gpu(ggml_backend_t backend) {
+    if (!backend || !backend->device || !backend->device->reg ||
+        strcmp(ggml_backend_reg_name(backend->device->reg), "StrataMoE") != 0) return nullptr;
+    using unwrap_fn = ggml_backend_t (*)(ggml_backend_t);
+    auto unwrap = reinterpret_cast<unwrap_fn>(ggml_backend_reg_get_proc_address(
+        backend->device->reg, "strata_a3b_async_gpu_backend_v1"));
+    return unwrap ? unwrap(backend) : nullptr;
+}
