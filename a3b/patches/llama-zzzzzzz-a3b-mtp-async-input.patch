+static bool mtp_device_i32_input_layout(const ggml_tensor * t, int64_t count) {
+    return t && t->data && t->type == GGML_TYPE_I32 && t->ne[0] == count &&
+           t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->nb[0] == sizeof(int32_t) && ggml_nbytes(t) == size_t(count) * sizeof(int32_t);
+}
+
+static bool mtp_device_i64_input_layout(const ggml_tensor * t) {
+    return t && t->data && t->type == GGML_TYPE_I64 && t->ne[0] == 1 &&
+           t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->nb[0] == sizeof(int64_t) && ggml_nbytes(t) == sizeof(int64_t);
+}
+
+static bool mtp_device_mask_input_layout(const ggml_tensor * t, size_t capacity) {
+    if (!t || !t->data || (t->type != GGML_TYPE_F16 && t->type != GGML_TYPE_F32) ||
+        t->ne[0] < 1 || t->ne[1] != 1 || t->ne[2] != 1 || t->ne[3] != 1 ||
+        t->nb[0] != ggml_type_size(t->type)) return false;
+    const size_t bytes = ggml_nbytes(t);
+    return bytes > 0 && bytes <= capacity &&
+           bytes == size_t(t->ne[0]) * ggml_type_size(t->type);
+}
+
+// One padded record per proposal step. The mask's worst case is one F32 value
+// for every KV cell; the ordinary CUDA page-locked host buffer allocator owns
+// both records until the final draft synchronize. No per-step stack/vector
+// storage is ever passed to cudaMemcpyAsync.
+struct mtp_k2_input_layout {
+    const size_t token = 0;
+    const size_t pos = sizeof(llama_token);
+    const size_t hidden = pos + 4 * sizeof(llama_pos);
+    const size_t out_ids;
+    const size_t k_idxs;
+    const size_t v_idxs;
+    const size_t kq_mask;
+    const size_t slot_bytes;
+
+    mtp_k2_input_layout(uint32_t width, uint32_t n_ctx) :
+        out_ids(hidden + size_t(width) * sizeof(float)),
+        k_idxs((out_ids + sizeof(int32_t) + 7) & ~size_t(7)),
+        v_idxs(k_idxs + sizeof(int64_t)),
+        kq_mask(v_idxs + sizeof(int64_t)),
+        slot_bytes((kq_mask + size_t(n_ctx) * sizeof(float) + 7) & ~size_t(7)) {}
+};
 
