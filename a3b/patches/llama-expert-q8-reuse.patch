+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// Exact verification flattens T x routed lanes into one pseudo token. Multiple
+// lanes can consequently reference the same expert. Retain the singleton K
+// partition, operation order and reduction, but load each Q8 block once for up
+// to two matching lanes. Each second duplicate starts another bounded group.
+// No host plan, dynamic allocation or extra GPU temporary is needed.
+template<bool small_k, bool fused_gate>
+__launch_bounds__(128, 1)
+static __global__ void strata_a3b_expert_q8_reuse(
+        const block_q8_0 * __restrict__ weights,
+        const block_q8_0 * __restrict__ gate,
+        const block_q8_1 * __restrict__ inputs,
+        const int32_t * __restrict__ ids,
+        float * __restrict__ output,
+        const int blocks_per_row, const int nrows, const int channels,
+        const int input_channels, const int stride_row_x,
+        const int stride_expert_x, const int stride_channel_y,
+        const int stride_channel_dst) {
+    constexpr int group_cap = 2, nwarps = 4, warp_size = 32;
+    constexpr int rows = small_k ? nwarps : 1;
+    constexpr int vdr = VDR_Q8_0_Q8_1_MMVQ;
+    constexpr int qi = ggml_cuda_type_traits<GGML_TYPE_Q8_0>::qi;
+    constexpr int blocks_per_iter = vdr * nwarps * warp_size / qi;
+    static_assert(vdr == 2 && qi == 8, "canonical Q8 expert lane mapping changed");
+    // One thread builds a tiny shared plan. Planning in every worker made
+    // the initial experiment repeat the ID scan 128 times per row CTA and
+    // could place dynamically indexed per-thread member arrays in local RAM.
+    __shared__ int members[group_cap], count, expert;
+    if (threadIdx.x == 0 && threadIdx.y == 0) {
+        const int first = blockIdx.y;
+        expert = ids[first];
+        int preceding = 0;
+        for (int c = 0; c < first; ++c) preceding += ids[c] == expert;
+        count = 0;
+        if (preceding % group_cap == 0)
+            for (int c = first; c < channels && count < group_cap; ++c)
+                if (ids[c] == expert) members[count++] = c;
+    }
+    __syncthreads();
+    if (count == 0) return;
+    const int row0 = rows * blockIdx.x;
+    const int tid = warp_size * threadIdx.y + threadIdx.x;
+    const int iqs = vdr * (tid % (qi / vdr));
+    float sums[group_cap][rows] = {{0.0f}};
+    float gates[group_cap][rows] = {{0.0f}};
+    ggml_cuda_pdl_sync();
+    for (int kbx = tid / (qi / vdr); kbx < blocks_per_row; kbx += blocks_per_iter) {
+#pragma unroll
+        for (int row = 0; row < rows; ++row) {
+            const int offset = expert * stride_expert_x + (row0 + row) * stride_row_x + kbx;
+            const block_q8_0 * bx = weights + offset;
+            const int v[vdr] = {get_int_b2(bx->qs, iqs), get_int_b2(bx->qs, iqs + 1)};
+            const float dx = bx->d;
+            int gv[vdr]; float gdx = 0.0f;
+            if constexpr (fused_gate) {
+                const block_q8_0 * bg = gate + offset;
+                gv[0] = get_int_b2(bg->qs, iqs); gv[1] = get_int_b2(bg->qs, iqs + 1);
+                gdx = bg->d;
+            }
+#pragma unroll
+            for (int member = 0; member < group_cap; ++member) if (member < count) {
+                const block_q8_1 * by = inputs +
+                    (members[member] % input_channels) * stride_channel_y + kbx;
+                const int u[vdr] = {get_int_b4(by->qs, iqs), get_int_b4(by->qs, iqs + 1)};
+                const half dy = __low2half(by->ds);
+                sums[member][row] += vec_dot_q8_0_q8_1_impl<float, vdr>(v, u, dx, dy);
+                if constexpr (fused_gate)
+                    gates[member][row] += vec_dot_q8_0_q8_1_impl<float, vdr>(gv, u, gdx, dy);
+            }
+            if constexpr (!fused_gate) GGML_UNUSED_VARS(gv, gdx);
+        }
+    }
+    __shared__ float partial[nwarps - 1][group_cap][rows][warp_size];
+    __shared__ float gate_partial[fused_gate ? nwarps - 1 : 1][group_cap][rows][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int member = 0; member < group_cap; ++member) if (member < count) {
+#pragma unroll
+            for (int row = 0; row < rows; ++row) {
+                partial[threadIdx.y - 1][member][row][threadIdx.x] = sums[member][row];
+                if constexpr (fused_gate)
+                    gate_partial[threadIdx.y - 1][member][row][threadIdx.x] = gates[member][row];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) return;
+#pragma unroll
+    for (int member = 0; member < group_cap; ++member) if (member < count) {
+#pragma unroll
+        for (int row = 0; row < rows; ++row) {
+#pragma unroll
+            for (int warp = 0; warp < nwarps - 1; ++warp) {
+                sums[member][row] += partial[warp][member][row][threadIdx.x];
+                if constexpr (fused_gate)
+                    gates[member][row] += gate_partial[warp][member][row][threadIdx.x];
+            }
+            sums[member][row] = warp_reduce_sum<warp_size>(sums[member][row]);
+            if constexpr (fused_gate)
+                gates[member][row] = warp_reduce_sum<warp_size>(gates[member][row]);
+            if (threadIdx.x == row && row0 + row < nrows) {
+                float result = sums[member][row];
+                if constexpr (fused_gate) {
+                    // The canonical fusion adds zero even when bias is absent.
+                    result += 0.0f;
+                    float gate_value = gates[member][row]; gate_value += 0.0f;
+                    result *= ggml_cuda_op_silu_single(gate_value);
+                }
+                output[members[member] * stride_channel_dst + row0 + row] = result;
+            }
+        }
+    }
+    if constexpr (!fused_gate) GGML_UNUSED_VARS(gate, gates, gate_partial);
+}
+
+static void strata_a3b_expert_q8_reuse_launch(
+        const void * weights, const void * gate, const void * inputs, const int32_t * ids,
+        float * output, int ncols, int nrows, int channels, int input_channels,
+        int stride_row_x, int stride_expert_x, int stride_channel_y,
+        int stride_channel_dst, cudaStream_t stream) {
+    // The unchanged SM75 Q8 singleton dispatcher selects small_k by this rule.
+    const bool small_k = ncols / QK8_0 < 32;
+    const dim3 grid((nrows + (small_k ? 4 : 1) - 1) / (small_k ? 4 : 1), channels, 1);
+    const dim3 block(32, 4, 1);
+#define STRATA_A3B_EXPERT_Q8_LAUNCH(SMALL, FUSED) \
+    strata_a3b_expert_q8_reuse<SMALL, FUSED><<<grid, block, 0, stream>>>( \
+        (const block_q8_0 *) weights, (const block_q8_0 *) gate, \
+        (const block_q8_1 *) inputs, ids, output, ncols / QK8_0, nrows, channels, \
+        input_channels, stride_row_x, stride_expert_x, stride_channel_y, stride_channel_dst)
+    if (small_k) {
+        if (gate) { STRATA_A3B_EXPERT_Q8_LAUNCH(true, true); }
+        else { STRATA_A3B_EXPERT_Q8_LAUNCH(true, false); }
+    } else {
+        if (gate) { STRATA_A3B_EXPERT_Q8_LAUNCH(false, true); }
+        else { STRATA_A3B_EXPERT_Q8_LAUNCH(false, false); }
+    }
+#undef STRATA_A3B_EXPERT_Q8_LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+}
+#endif
