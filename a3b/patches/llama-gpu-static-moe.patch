+#pragma once
+#include "ggml.h"
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Optional CUDA registry entry "ggml_backend_cuda_strata_moe_v1" returns a
+// function with this get-api signature. No direct CUDA linkage is required by
+// callers. The API exists only on native NVIDIA CUDA builds.
+// STRATA_A3B_NATIVE_EXPERT_REUSE=2 or 4 optionally shares Q8 weight loads
+// across bounded same-expert channel groups for T>1. Default 0 keeps the
+// singleton kernels; grouping changes no per-channel arithmetic or routing.
+#define GGML_CUDA_STRATA_MOE_ABI_V1 1
+// Optional original-Strata style CPU expert service. Called by one persistent
+// host service thread per CUDA device, never by a CUDA host callback. The
+// payload is contiguous [tokens,input_lanes,2048], IDs [tokens,8], and output
+// [tokens,8,2048]. Only valid IDs whose slot is -1 need an output row. No CUDA
+// calls are permitted from this callback. Return 0 with an error on failure.
+typedef int (*ggml_cuda_strata_moe_cpu_v1)(void * user,
+    const float * input, int input_lanes, int tokens, const int32_t * logical_ids,
+    const int32_t * slot_of_expert, float * output, char * error, size_t error_size);
+struct ggml_cuda_strata_moe_layer_v1 {
+    // gate, up, down: original immutable host Q8_0 tensors, never graph inputs.
+    // Geometry is [2048,512,256], [2048,512,256], [512,2048,256].
+    const struct ggml_tensor * host_weights[3];
+    // Same projection order. Each cache tensor has ne[2]=cache_slots. A null
+    // cache is valid only for cache_slots=0. All slots are shared by the roles.
+    const struct ggml_tensor * cached_weights[3];
+    int32_t cache_slots;
+    int32_t slot_of_expert[256]; // -1 for a miss, otherwise [0,cache_slots)
+    // Opt-in GPU admission/eviction. The immutable host arena still owns all
+    // 256 experts. Dynamic mode maps an additional complete host copy so an
+    // evicted initial cache expert can be loaded again without a CPU route.
+    int32_t dynamic_cache; // 0 fixed profile (default), 1 device LFU/recency
+    // Non-null selects a fixed-cache hybrid mailbox. Large host expert weights
+    // remain ordinary RAM and are not copied/mapped by the CUDA operator.
+    ggml_cuda_strata_moe_cpu_v1 cpu_callback;
+    void * cpu_user;
+};
+// Called once, on the host, immediately before graph execution/capture, never
+// from inside stream capture. Return 0 and an explanatory error on failure.
+// The provider materializes the initial cache only after the real engine
+// budget/profile exists. Returned weight tensors remain alive until destroy.
+typedef int (*ggml_cuda_strata_moe_prepare_v1)(void * user,
+    struct ggml_cuda_strata_moe_layer_v1 * layer, char * error, size_t error_size);
+
+struct ggml_cuda_strata_moe_stats_v1 {
+    uint64_t calls, rows, miss_rows, unique_misses, upload_bytes, miss_calls;
+    uint64_t routes[256];
+    uint64_t mapped_host_bytes; // extra RAM: complement fixed, all experts dynamic
+    uint64_t shared_gpu_scratch_bytes; // shared across all handles on GPU 0
+    double prepare_ms;
+    uint32_t device_error; // 0 success; 1 invalid routed expert id
+    // Current GPU cache contents. Collect at request boundaries before using
+    // the same cache tensors from a host-planned long-prefill path. Resetting
+    // counters never resets slots, LFU history, or the dynamic policy.
+    int32_t cache_slots;
+    int32_t dynamic_cache;
+    int32_t slot_of_expert[256];
+    uint64_t cache_admissions, cache_decays;
+    uint64_t cpu_rows, gpu_rows;
+    uint64_t host_callback_requests;
+    double host_callback_ms;
+    // Small mapped activation/ID and CPU-output traffic, separate from expert
+    // weight upload_bytes (which remains zero in CPU mailbox mode).
+    uint64_t mailbox_to_host_bytes, mailbox_to_device_bytes;
+};
+struct ggml_cuda_strata_moe_api_v1 {
+    uint32_t abi_version;
+    // create/build perform no large allocation and invoke no provider.
+    void * (*create)(int device, ggml_cuda_strata_moe_prepare_v1 prepare,
+                     void * user, char * error, size_t error_size);
+    struct ggml_tensor * (*build)(void * handle, struct ggml_context * ctx,
+                                 struct ggml_tensor * input, struct ggml_tensor * ids);
+    // Request-boundary operation: joins the last execution stream once, copies
+    // counters/histogram and the current slot map, and optionally resets
+    // counters. Mapping/scratch sizes, cache slots, policy history and
+    // preparation time are never reset. Returns 0 on
+    // runtime/device error, but fills stats so callers can diagnose the cause.
+    int (*get_stats)(void * handle, int reset,
+                     struct ggml_cuda_strata_moe_stats_v1 * stats,
+                     char * error, size_t error_size);
+    void (*destroy)(void * handle);
+    uint64_t (*scratch_bytes)(void); // budget before cache materialization
+};
+typedef const struct ggml_cuda_strata_moe_api_v1 *
+    (*ggml_cuda_strata_moe_get_api_v1)(void);
+#ifdef __cplusplus
+}
+#endif
