+// A3B Q6_K verification only: decode each weight lane once for 2-4 columns.
+// This is the same block addressing and two-term float expression as
+// vec_dot_q6_K_q8_1[_impl_mmvq] in vecdotq.cuh.  The K loop, two-warp partial
+// sums and warp reduction stay in mul_mat_vec_q unchanged.
+struct strata_a3b_q6_mmvq_weight {
+    int vi0, vi1;
+    int sc0, sc1;
+    int bq8_offset;
+    float d;
+};
+
+static __device__ __forceinline__ strata_a3b_q6_mmvq_weight strata_a3b_q6_mmvq_load(
+        const block_q6_K * bx, int iqs) {
+    static_assert(QR6_K == 2 && QI6_K == 32 && QI8_1 == 8, "Q6_K lane geometry changed");
+    const int bq8_offset = 2*QR6_K*(iqs/(QI6_K/2)) + (iqs%(QI6_K/2))/(QI6_K/4);
+    const int scale_offset = (QI6_K/4)*(iqs/(QI6_K/2)) + (iqs%(QI6_K/2))/(QI6_K/8);
+    const int vh_shift = 2*((iqs%(QI6_K/2))/(QI6_K/4));
+    const int vl = get_int_b2(bx->ql, iqs);
+    const int vh = get_int_b2(bx->qh, (QI6_K/4)*(iqs/(QI6_K/2)) + iqs%(QI6_K/4)) >> vh_shift;
+    const int vi0 = __vsubss4((vl & 0x0F0F0F0F) | ((vh << 4) & 0x30303030), 0x20202020);
+    const int vi1 = __vsubss4(((vl >> 4) & 0x0F0F0F0F) | (vh & 0x30303030), 0x20202020);
+    return {vi0, vi1, bx->scales[scale_offset], bx->scales[scale_offset + 4], bq8_offset, bx->d};
+}
+
+static __device__ __forceinline__ float strata_a3b_q6_mmvq_apply(
+        const strata_a3b_q6_mmvq_weight & w, const block_q8_1 * y, int iqs) {
+    const block_q8_1 * y0 = y + w.bq8_offset;
+    const int u0 = get_int_b4(y0[0].qs, iqs%QI8_1);
+    const int u1 = get_int_b4(y0[2].qs, iqs%QI8_1);
+    const float d80 = __low2float(y0[0].ds);
+    const float d81 = __low2float(y0[2].ds);
+    float sumf = 0.0f;
+    sumf += d80 * (ggml_cuda_dp4a(w.vi0, u0, 0) * w.sc0);
+    sumf += d81 * (ggml_cuda_dp4a(w.vi1, u1, 0) * w.sc1);
+    return w.d * sumf;
+}
