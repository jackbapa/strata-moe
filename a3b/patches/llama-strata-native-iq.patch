@@ -0,0 +1,75 @@
+#include "strata-native-iq.cuh"
+#include "ggml-cuda.h"
+#include "strata_native_experts.hpp"
+#include "ggml-impl.h"
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <stdexcept>
+
+namespace {
+std::atomic<bool> any_ops{false};
+std::mutex state_lock;
+strata_a3b::StrataNativeExperts * state[GGML_CUDA_MAX_DEVICES]{};
+void marker(ggml_tensor *, int, int, void *) {
+    GGML_ABORT("Strata native IQ experts require CUDA");
+}
+bool geometry(const ggml_tensor * gate, const ggml_tensor * up, const ggml_tensor * down,
+    const ggml_tensor * x, const ggml_tensor * ids) {
+    return strata_a3b::strata_native_experts_compatible(gate, up, down) &&
+        gate->ne[0] == 2048 && gate->ne[1] == 512 && gate->ne[2] == 256 &&
+        x && ids && x->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 &&
+        x->ne[0] == 2048 && (x->ne[1] == 1 || x->ne[1] == 8) &&
+        x->ne[2] >= 1 && x->ne[2] <= 8 && x->ne[3] == 1 &&
+        ids->ne[0] == 8 && ids->ne[1] == x->ne[2] &&
+        ids->ne[2] == 1 && ids->ne[3] == 1;
+}
+}
+
+ggml_tensor * ggml_backend_cuda_strata_iq_build(ggml_context * ctx,
+    ggml_tensor * gate, ggml_tensor * up, ggml_tensor * down,
+    ggml_tensor * input, ggml_tensor * ids) {
+    if (!ctx || !geometry(gate, up, down, input, ids)) return nullptr;
+    ggml_tensor * args[] = {gate, up, down, input, ids};
+    auto * op = ggml_custom_4d(ctx, GGML_TYPE_F32, 2048, 8, ids->ne[1], 1,
+        args, 5, marker, 1, nullptr);
+    ggml_set_name(op, "strata_native_iq_experts");
+    any_ops.store(true, std::memory_order_relaxed);
+    return op;
+}
+
+bool ggml_cuda_strata_iq_is_op(const ggml_tensor * op) {
+    if (!op || op->op != GGML_OP_CUSTOM) return false;
+    ggml_custom_op_params params{};
+    std::memcpy(&params, op->op_params, sizeof(params));
+    return params.fun == marker;
+}
+bool ggml_cuda_strata_iq_any_ops() { return any_ops.load(std::memory_order_relaxed); }
+
+bool ggml_cuda_strata_iq_prepare(ggml_backend_cuda_context & ctx, const ggml_tensor * op,
+    char * error, size_t error_size) {
+    try {
+        if (!ggml_cuda_strata_iq_is_op(op) || !geometry(op->src[0], op->src[1], op->src[2],
+                op->src[3], op->src[4]))
+            throw std::runtime_error("invalid Strata IQ CUDA expert operation");
+        if (ctx.device != 0) throw std::runtime_error("Strata IQ CUDA path currently requires GPU 0");
+        std::lock_guard<std::mutex> guard(state_lock);
+        if (!state[ctx.device]) state[ctx.device] = strata_a3b::strata_native_experts_create(64, 2048, 512);
+        return true;
+    } catch (const std::exception & e) {
+        if (error && error_size) std::snprintf(error, error_size, "%s", e.what());
+        return false;
+    }
+}
+
+void ggml_cuda_strata_iq_compute(ggml_backend_cuda_context & ctx, ggml_tensor * op) {
+    GGML_ASSERT(state[ctx.device]);
+    strata_a3b::strata_native_experts_compute(state[ctx.device], ctx.stream(),
+        op->src[0], op->src[1], op->src[2], op->src[3], op->src[4], op);
+}
+
+uint64_t ggml_backend_cuda_strata_iq_calls(void) {
+    std::lock_guard<std::mutex> guard(state_lock);
+    return strata_a3b::strata_native_experts_calls(state[0]);
+}
