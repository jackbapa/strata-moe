+int llama_mtp_device_chain_k2(llama_context * draft, llama_batch first,
+                              llama_batch second, uint32_t width,
+                              llama_token * tokens, float * guards,
+                              uint32_t * inter_step_syncs) {
+    if (!draft || !tokens || !guards || !inter_step_syncs || !first.token || !first.embd ||
+        !second.token || !second.embd || !first.pos || !second.pos ||
+        !first.n_seq_id || !second.n_seq_id || !first.seq_id || !second.seq_id ||
+        !first.logits || !second.logits || first.n_tokens != 1 || second.n_tokens != 1 ||
+        first.pos[0] < 0 || int64_t(second.pos[0]) != int64_t(first.pos[0]) + 1 ||
+        first.n_seq_id[0] != 1 || second.n_seq_id[0] != 1 ||
+        !first.seq_id[0] || !second.seq_id[0] ||
+        first.seq_id[0][0] != 0 || second.seq_id[0][0] != 0 ||
+        !first.logits[0] || !second.logits[0] ||
+        draft->model.arch != LLM_ARCH_QWEN35MOE ||
+        draft->get_cparams().ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+        draft->get_cparams().n_seq_max != 1 ||
+        draft->get_cparams().n_ubatch < 1 ||
+        draft->model.hparams.n_layer_nextn != 1 ||
+        width != draft->model.hparams.n_embd_out() ||
+        draft->sampling.samplers.size() != 1 ||
+        draft->mtp_device_prefill.target ||
+        draft->mtp_device_chain.active ||
+        draft->mtp_device_chain.input_pending) return 0;
+
+    auto & chain = draft->mtp_device_chain;
+    ggml_backend_t cuda_backend = nullptr;
+    for (const auto & backend : draft->backends) {
+        if (mtp_device_cuda_backend(backend.get())) {
+            cuda_backend = backend.get();
+            break;
+        }
+    }
+    if (!cuda_backend) return 0;
+    const auto device = ggml_backend_get_device(cuda_backend);
+    // A host token table makes GET_ROWS a CPU split. Feeding the sampled
+    // scalar through a CUDA input in that graph can race its CPU-side index
+    // copy. Only chain when the draft embedding lookup itself runs on CUDA;
+    // otherwise return before touching the draft KV and use the old path.
+    const auto & mtp_layer = draft->model.layers.at(draft->model.hparams.n_layer());
+    const ggml_tensor * token_table = mtp_layer.nextn.embed_tokens ?
+        mtp_layer.nextn.embed_tokens : draft->model.tok_embd;
+    if (!token_table || !mtp_device_cuda_buffer(token_table, cuda_backend)) return 0;
+    if (chain.device && (chain.device != device || chain.width != width)) return 0;
+    if (!chain.token || !chain.hidden || !chain.first_host) {
+        auto * buft = ggml_backend_get_default_buffer_type(cuda_backend);
+        auto * host_buft = ggml_backend_dev_host_buffer_type(device);
+        if (!buft || !host_buft) return 0;
+        auto token = ggml_backend_buffer_ptr(ggml_backend_buft_alloc_buffer(buft, sizeof(llama_token)));
+        auto hidden = ggml_backend_buffer_ptr(ggml_backend_buft_alloc_buffer(buft, size_t(width) * sizeof(float)));
+        auto host = ggml_backend_buffer_ptr(ggml_backend_buft_alloc_buffer(host_buft, 16));
+        if (!token || !hidden || !host || !ggml_backend_buffer_is_host(host.get())) return 0;
+        chain.token = std::move(token);
+        chain.hidden = std::move(hidden);
+        chain.first_host = std::move(host);
+        chain.device = device;
+        chain.width = width;
+    }
+
+    // The first graph is already one CUDA submission. Queue stable D2D copies
+    // before llama_decode may recycle its graph arena, then let step two read
+    // those buffers. No sampled-token or hidden getter runs between steps.
+    chain.active = true;
+    chain.first_step_output = true;
+    auto finish = [&chain](int status) {
+        chain.active = false;
+        chain.first_step_output = false;
+        chain.input_pending = false;
+        chain.between_steps = false;
+        return status;
+    };
+    int first_rc = -1;
+    try {
+        first_rc = draft->decode(first);
+    } catch (...) {
+        finish(-1);
+        throw;
+    }
+    chain.first_step_output = false;
+    if (first_rc != 0) return finish(-1);
+    auto * result = draft->gf_res_prev_active;
+    auto * h = result ? result->get_h_nextn() : nullptr;
+    auto * sampled = result && result->t_sampled.size() == 1 ? result->t_sampled[0] : nullptr;
+    auto * guard = result && result->t_sampled_probs.size() == 1 ? result->t_sampled_probs[0] : nullptr;
+    if (!mtp_device_hidden_layout(h, width, 1) || !sampled || !guard ||
+        sampled->type != GGML_TYPE_I32 || ggml_nelements(sampled) != 1 ||
+        guard->type != GGML_TYPE_F32 || ggml_nelements(guard) != 1) return finish(-1);
+    const auto h_backend = ggml_backend_sched_get_tensor_backend(draft->sched.get(), h);
+    const auto sampled_backend = ggml_backend_sched_get_tensor_backend(draft->sched.get(), sampled);
+    const auto guard_backend = ggml_backend_sched_get_tensor_backend(draft->sched.get(), guard);
+    if (!mtp_device_cuda_buffer(h, h_backend) ||
+        !mtp_device_cuda_buffer(sampled, sampled_backend) ||
+        !mtp_device_cuda_buffer(guard, guard_backend) ||
+        ggml_backend_get_device(h_backend) != device ||
+        ggml_backend_get_device(sampled_backend) != device ||
+        ggml_backend_get_device(guard_backend) != device) return finish(-1);
+
+    chain.token_backend = sampled_backend;
+    chain.hidden_backend = h_backend;
+    auto pending_token = mtp_device_pending_tensor(sampled, chain.token.get());
+    auto pending_hidden = mtp_device_pending_tensor(h, chain.hidden.get());
+    ggml_backend_tensor_copy_async(sampled_backend, sampled_backend, sampled, &pending_token);
+    ggml_backend_tensor_copy_async(h_backend, h_backend, h, &pending_hidden);
+    auto * first_host = static_cast<char *>(ggml_backend_buffer_get_base(chain.first_host.get()));
+    ggml_backend_tensor_get_async(sampled_backend, sampled, first_host, 0, sizeof(llama_token));
+    ggml_backend_tensor_get_async(guard_backend, guard, first_host + 8, 0, sizeof(float));
+
+    chain.inter_step_syncs = 0;
+    chain.input_pending = true;
+    chain.between_steps = true;
+    int rc = -1;
+    try {
+        rc = draft->decode(second);
+    } catch (...) {
+        finish(-1);
+        throw;
+    }
+    chain.between_steps = false;
+    if (rc != 0 || chain.input_pending) {
+        return finish(-1);
+    }
+    // Exactly one explicit context synchronization after both proposal graphs.
+    draft->synchronize();
+    std::memcpy(&tokens[0], first_host, sizeof(llama_token));
+    std::memcpy(&guards[0], first_host + 8, sizeof(float));
+    tokens[1] = draft->get_sampled_token_ith(-1);
+    const float * second_guard = draft->get_sampled_probs_ith(-1);
+    guards[1] = second_guard ? second_guard[0] : NAN;
+    *inter_step_syncs = chain.inter_step_syncs;
+    return finish(1);
+}
